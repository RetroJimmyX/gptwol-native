[Unit]
Description=GPTWOL web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gptwol
Group=gptwol
WorkingDirectory=/opt/gptwol
Environment=PYTHONPATH=/opt/gptwol/app
Environment=GPTWOL_DATA_DIR=/var/lib/gptwol
Environment=GPTWOL_SCHEDULE_FILE=/var/lib/gptwol/gptwol.cron
Environment=HOST=127.0.0.1
Environment=PORT=5000
ExecStart=/opt/gptwol/.venv/bin/python -u /opt/gptwol/app/wol.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gptwol

[Install]
WantedBy=multi-user.target
