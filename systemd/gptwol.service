[Unit]
Description=GPTWOL web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gptwol
Group=gptwol
WorkingDirectory=/opt/gptwol
Environment=PYTHONPATH=/opt/gptwol/app
Environment=GPTWOL_DATA_DIR=/var/lib/gptwol
Environment=GPTWOL_SCHEDULE_FILE=/var/lib/gptwol/gptwol.cron
Environment=HOST=0.0.0.0
Environment=PORT=5000
ExecStart=/opt/gptwol/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 wol:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gptwol

[Install]
WantedBy=multi-user.target
